{
  "name": "my-nextjs-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @my-nextjs-agent/web dev",
    "build": "pnpm --filter @my-nextjs-agent/web build",
    "start": "pnpm --filter @my-nextjs-agent/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:check": "pnpm --filter @my-nextjs-agent/web db:check",
    "db:generate": "pnpm --filter @my-nextjs-agent/web db:generate",
    "db:migrate": "pnpm --filter @my-nextjs-agent/web db:migrate",
    "db:push": "pnpm --filter @my-nextjs-agent/web db:push",
    "db:studio": "pnpm --filter @my-nextjs-agent/web db:studio",
    "agent:dev": "pnpm --filter @my-nextjs-agent/agent langgraph:dev",
    "format": "prettier --write .",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,mdx,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3"
  }
}
